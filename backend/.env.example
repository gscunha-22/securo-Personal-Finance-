DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/securo
# Neon: API and Celery use the pooled (-pooler) URL. Alembic, pg_dump and
# restore use the direct compute. Leave DATABASE_URL_DIRECT empty for local
# Compose Postgres. If only the pooler URL is set, Alembic derives the
# direct host by stripping "-pooler" from the hostname.
# DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?ssl=require
# DATABASE_URL_DIRECT=postgresql+asyncpg://user:pass@ep-xxx.region.aws.neon.tech/neondb?ssl=require
SECRET_KEY=change-me-in-production
DEBUG=true
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_OAUTH_REDIRECT_URI=http://localhost:5173/oauth/callback
FRONTEND_URL=http://localhost:5173
REDIS_URL=redis://localhost:6379/0
# Brazilian Treasury bond prices. On by default; set to false to disable
# (e.g. to avoid the dependency on the Brazilian government CSV endpoint).
TESOURO_DIRETO_ENABLED=true

# Number of trusted reverse proxies in front of the backend (the bundled nginx
# frontend counts as 1). Rate limiting keys requests by client IP; leaving this
# at 0 in a proxied deployment means every client shares one rate-limit bucket.
# Vercel same-origin /api rewrite counts as 1 hop in front of FastAPI.
TRUSTED_PROXY_HOPS=0

# Optional OIDC login (Authentik, Pocket ID, or standard OIDC providers)
OIDC_ENABLED=false
OIDC_PROVIDER_NAME=OIDC
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Defaults to ${FRONTEND_URL}/api/auth/oidc/callback
OIDC_REDIRECT_URI=
OIDC_SCOPES=openid email profile
OIDC_AUTO_REGISTER=true
OIDC_REQUIRE_VERIFIED_EMAIL=true
# Set to false only with OIDC_ENABLED=true, OIDC_CLIENT_ID, and OIDC_DISCOVERY_URL configured
LOCAL_AUTH_ENABLED=true
OIDC_SYNC_ROLES=false
OIDC_ROLES_CLAIM=groups
OIDC_ADMIN_ROLES=
OIDC_WORKSPACE_ROLE_MAP=

# Private single-owner instance
# PRIVATE_INSTANCE=false
# STORAGE_MAX_DOCUMENT_SIZE_MB=20
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# Register the OAuth redirect URI as ${FRONTEND_URL}/sources/callback
# (gmail.readonly, spreadsheets.readonly, Mail.Read only).
# AI_PROVIDER_BASE_URL=
# AI_PROVIDER_API_KEY=
# Cloud vault: STORAGE_PROVIDER=s3 (not local disk on ephemeral compute)
# STORAGE_PROVIDER=s3
# STORAGE_S3_BUCKET=securo-vault
# STORAGE_S3_REGION=us-east-2
# STORAGE_S3_ENDPOINT_URL=
# STORAGE_S3_ACCESS_KEY=
# STORAGE_S3_SECRET_KEY=
# STORAGE_PROVIDER=local
